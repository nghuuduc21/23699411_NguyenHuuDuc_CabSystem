# Mẫu biến môi trường của Cab Booking System — 14 biến (docs/design/03-du-lieu.md mục 13).
# Dùng: cp .env.example .env   rồi   docker compose up -d --build
#
# Mọi giá trị dưới đây là GIÁ TRỊ MẪU CHỈ CHO MÁY DEMO. File này có trên Git nên các khóa này
# không bí mật. Chạy thật: đổi hết khóa và mật khẩu trong .env (file .env KHÔNG commit).

# Mật khẩu chung của user `cab` ở cả 8 database (7 PostgreSQL + MongoDB).
DB_PASSWORD=cab123

# Khóa ký JWT HS256 (ADR-016), ít nhất 32 ký tự. Chỉ auth-service (ký) và gateway (kiểm tra) nhận.
JWT_SECRET=demo-jwt-secret-chi-dung-cho-may-demo-32b
# Thời gian sống của token (giây).
JWT_TTL_SECONDS=3600

# Khóa AES-256-GCM mã hóa họ tên, ngày sinh (customer) và số giấy phép lái xe (driver), ADR-012.
# Đúng 32 byte, viết dạng base64 (44 ký tự). Hai khóa khác nhau; mỗi khóa chỉ một service nhận.
# Sinh khóa mới: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CUSTOMER_DATA_KEY=e4fagXyQTaShSOL5UJhYOsr9D7vmcxSrVEY3qz3uJZc=
DRIVER_DATA_KEY=7aJJosWnCMUT10tTeiYxEiYpVfX1f/cJc6VT4v5DAvk=

# Khóa cố định trong header X-Callback-Secret của callback thanh toán giả lập (ADR-014).
PAYMENT_CALLBACK_SECRET=cab-secret

# true: OTP trả trong response, cho phép simulate_result, chạy seed khi khởi động (ADR-014).
# Chạy thật: false.
SIMULATION_MODE=true
# Mật khẩu chung của mọi tài khoản seed.
SEED_PASSWORD=12345678

# Giới hạn thời gian (giây) — là giới hạn TRÊN, chỉnh ngắn lại khi cần demo trường hợp hết hạn.
PAYMENT_TIMEOUT_SECONDS=600
OFFER_TIMEOUT_SECONDS=300
OTP_TTL_SECONDS=300

# Rate limit ở Gateway (mục chấm 29): cửa sổ 10 giây, 5 request công khai theo IP, 30 request có token.
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_PUBLIC_MAX=5
RATE_LIMIT_ACCOUNT_MAX=30
