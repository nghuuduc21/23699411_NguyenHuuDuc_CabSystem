# Mẫu biến môi trường của Cab Booking System — 14 biến (docs/design/03-du-lieu.md mục 13).
# Dùng: cp .env.example .env   →   điền 5 biến BÍ MẬT bên dưới   →   docker compose up -d --build
#
# File này có trên Git nên KHÔNG chứa giá trị bí mật: 5 biến bí mật để trống, mỗi máy tự sinh trong .env
# (file .env KHÔNG commit). Biến không bí mật (thời gian, ngưỡng, chế độ giả lập) giữ giá trị mặc định.
# Thiếu biến bí mật → service không khởi động, log nêu tên biến.
#
# Sinh khóa ngẫu nhiên 32 byte (base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---------- BÍ MẬT (bắt buộc điền trong .env) ----------

# Mật khẩu chung của user `cab` ở cả 8 database (7 PostgreSQL + MongoDB). Chỉ chữ và số.
DB_PASSWORD=

# Khóa ký JWT HS256 (ADR-016), ít nhất 32 ký tự. Chỉ auth-service (ký) và gateway (kiểm tra) nhận.
JWT_SECRET=

# Khóa AES-256-GCM mã hóa họ tên, ngày sinh (customer) và số giấy phép lái xe (driver), ADR-012.
# Đúng 32 byte dạng base64 (44 ký tự), sinh bằng lệnh ở trên. Hai khóa khác nhau; mỗi khóa chỉ một service nhận.
CUSTOMER_DATA_KEY=
DRIVER_DATA_KEY=

# Khóa trong header X-Callback-Secret của callback thanh toán (ADR-014). Ngắn để gõ tay khi demo mục 19.
PAYMENT_CALLBACK_SECRET=

# ---------- KHÔNG BÍ MẬT (giá trị mặc định cho máy demo) ----------

# Thời gian sống của token (giây).
JWT_TTL_SECONDS=3600

# true: OTP trả trong response, cho phép simulate_result, chạy seed khi khởi động (ADR-014).
# Chạy thật: false.
SIMULATION_MODE=true
# Mật khẩu chung của mọi tài khoản seed (chỉ dùng khi SIMULATION_MODE=true).
SEED_PASSWORD=12345678

# Giới hạn thời gian (giây) — là giới hạn TRÊN, chỉnh ngắn lại khi cần demo trường hợp hết hạn.
PAYMENT_TIMEOUT_SECONDS=600
OFFER_TIMEOUT_SECONDS=300
OTP_TTL_SECONDS=300

# Rate limit ở Gateway (mục chấm 29): cửa sổ 10 giây; đặt xe 5 lần mỗi tài khoản (demo mục 29),
# 5 request công khai theo IP (đăng nhập, đăng ký), 30 request có token cho các route còn lại.
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_PUBLIC_MAX=5
RATE_LIMIT_ACCOUNT_MAX=30
RATE_LIMIT_BOOKING_MAX=5
